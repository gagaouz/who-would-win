{
  "name": "who-would-win-backend",
  "version": "1.0.0",
  "description": "Backend API for Who Would Win? iOS app",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r dotenv/config src/index.ts",
    "build": "tsc && node -e \"for (const name of ['style-reference.png','privacy.html']) require('fs').copyFileSync('src/customFighters/'+name, 'dist/customFighters/'+name)\"",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@apple/app-store-server-library": "^3.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "node-app-attest": "^1.0.1",
    "pg": "^8.23.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^20.19.17",
    "@types/pg": "^8.15.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "pg-mem": "^3.0.14",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
