{
  "name": "who-would-win-backend",
  "version": "1.0.0",
  "description": "Backend API for Who Would Win? iOS app",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r dotenv/config src/index.ts",
    "build": "tsc",
