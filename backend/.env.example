ANTHROPIC_API_KEY=your_key_here
PORT=3000

# Set to "1" when deploying behind a reverse proxy (Railway, Render, Heroku, Fly.io).
# This lets Express read the real client IP from the proxy-injected X-Forwarded-For
# header so per-IP rate limiting works correctly in production.
# Leave unset for local development (uses raw socket IP, which cannot be spoofed).
TRUST_PROXY=

# Comma-separated list of allowed CORS origins for web clients.
# Leave blank to reject browser origins while continuing to allow native iOS
# requests, which do not send an Origin header.
# Example: https://yourwebsite.com,https://app.yourwebsite.com
ALLOWED_ORIGINS=

# Postgres connection string. Auto-injected by the Railway Postgres plugin.
# If unset, battle logging silently no-ops and the leaderboard/admin endpoints
# return empty data. Set this in production to enable persistent stats.
DATABASE_URL=

# Static token guarding /admin/* routes. Generate a long random string
# (e.g. `openssl rand -hex 32`) and set it in Railway env. Send it through
# HTTP Basic auth or the x-admin-secret header; URL query tokens are rejected.
ADMIN_SECRET=

# Paid-AI safety controls. Production fails closed if the Postgres-backed
# budget ledger is unavailable.
AI_ENABLED=true
AI_DAILY_BUDGET_USD=2
AI_MONTHLY_BUDGET_USD=25
AI_MAX_CONCURRENT=4
COST_CONTROL_FAIL_CLOSED=true

# App Attest: deploy the attesting iOS build before switching enforcement on.
APP_ATTEST_TEAM_ID=8U69B876XS
APP_ATTEST_BUNDLE_ID=com.whowouldin.WhoWouldWin
APP_ATTEST_ENFORCE=false
APP_ATTEST_ALLOW_DEVELOPMENT=false
APP_ATTEST_LIMIT_PER_HOUR=120
APP_ATTEST_GLOBAL_PER_HOUR=10000

# HMAC salt for anonymous rate-limit fingerprints. Use a random secret that is
# separate from ADMIN_SECRET.
RATE_LIMIT_SALT=

ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_MS=15000
DIAGNOSTICS_ENABLED=false
